{
  "name": "@sfdc-recorder/runner",
  "version": "0.1.0",
  "description": "CLI to generate Playwright tests from sfdc-recorder recordings, manage Salesforce sessions, and replay flows.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "sfdc-rec": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./waits": {
      "types": "./dist/utils/salesforceWaits.d.ts",
      "import": "./dist/utils/salesforceWaits.js"
    },
    "./sfdcFields": {
      "types": "./dist/utils/sfdcFields.d.ts",
      "import": "./dist/utils/sfdcFields.js"
    },
    "./fixtures": {
      "types": "./dist/utils/fixtures.d.ts",
      "import": "./dist/utils/fixtures.js"
    }
  },
  "files": ["dist", "playwright.config.ts"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@sfdc-recorder/codegen": "workspace:*",
    "@sfdc-recorder/locator-engine": "workspace:*",
    "@playwright/test": "^1.45.3",
    "commander": "^12.1.0",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
